# Amakomaya Pregnancy Care MCP Server
# A pregnant woman logs in with her phone number + Keycloak password, and
# gets back a plain-language summary of her own FHIR pregnancy record.

# --- FHIR R5 server -----------------------------------------------------
FHIR_BASE_URL=https://api.amakomaya.com
# Service-account credentials the server uses for every FHIR call. These
# are read from the environment -- never hardcoded in source -- so they
# never end up committed to git.
FHIR_USERNAME=fhir_admin
FHIR_PASSWORD=change-me
# FHIR_TOKEN=...                 # bearer token, preferred over username/password
# FHIR_VERIFY_SSL=false          # only for self-signed certs
# FHIR_TIMEOUT=60

# Identifier system used to match a logged-in user's phone number to her
# FHIR Patient resource, i.e. Patient.identifier[system]. Defaults to the
# value below if unset.
# FHIR_PATIENT_IDENTIFIER_SYSTEM=https://api.amakomaya.com/nepal-telecome-system

# --- Keycloak (used to verify her phone number + password login) --------
KEYCLOAK_ISSUER=https://keycloak.amakomaya.com/realms/amakomaya
KEYCLOAK_CLIENT_ID=amakomaya-mcp
# KEYCLOAK_CLIENT_SECRET=...     # only if the client is confidential
# KEYCLOAK_AUDIENCE=...          # optional; verifies token was issued for this client
# KEYCLOAK_JWKS_URL=...          # optional override; defaults to <issuer>/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=...         # optional override; defaults to <issuer>/protocol/openid-connect/token
# KEYCLOAK_VERIFY_SSL=false      # only for self-signed certs

# KEYCLOAK_CLIENT_ID must have "Direct Access Grants" enabled in Keycloak --
# that's what allows a username+password login instead of a browser redirect.
