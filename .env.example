# ==========================================
# Amakomaya MCP Server - Environment Config
# ==========================================
#
# This build has NO authentication - only FHIR connectivity is
# configured here. See README.md for scope.

# --- FHIR Server ---
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT=30
FHIR_MAX_RETRIES=3

# Credentials - all optional, and mutually exclusive in practice:
#   - Set FHIR_TOKEN to use Bearer authentication (takes priority).
#   - Otherwise set both FHIR_USERNAME and FHIR_PASSWORD for Basic auth.
#   - Leave all three blank to call the FHIR server unauthenticated.
FHIR_USERNAME=
FHIR_PASSWORD=
FHIR_TOKEN=

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
