# ==========================================
# Amakomaya MCP Server - Environment Config
# ==========================================

# --- Keycloak (Authentication) ---
KEYCLOAK_URL=https://auth.amakomaya.com
KEYCLOAK_REALM=amakomaya
KEYCLOAK_CLIENT_ID=amakomaya-mcp
KEYCLOAK_CLIENT_SECRET=bzAH85T79L1DVtnh4i9pIEuB7bpHO0r1
# Public redirect URI registered in Keycloak for this MCP server
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# --- FHIR Server ---
FHIR_BASE_URL=https://api.amakomaya.com
FHIR_TIMEOUT=30
# Service-account bearer token used for the Patient lookup step only
# (never used to fetch clinical data - all clinical reads are patient-scoped)
FHIR_SERVICE_TOKEN=

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Session ---
# Secret used to sign the server-side session cookie/id (not the JWT itself)
SESSION_SECRET_KEY=change-me-in-production
SESSION_TTL_SECONDS=3600
